-- GoatCounter database schema (SQLite).
--
-- Sites are configured through GOATCOUNTER_SITES; there is intentionally no
-- sites table. The configured site name is stored as `site` on data rows.

create table hits (
	hit_id         {{auto_increment true}},
	site           varchar        not null,
	path_id        integer        not null,
	ref_id         integer        not null default 1,

	session        {{blob}}       default null,
	first_visit    integer        default 0,

	browser_id     integer        not null,
	system_id      integer        not null,
	campaign       integer        default null,
	width          int            null,
	location       varchar        not null default '',
	language       varchar        default null,

	created_at     timestamp      not null                 check(strftime('%s', created_at) is not null)
);
create index "hits#site#created_at" on hits(site, datetime(created_at) desc);

create table bots (
	site           varchar        not null,
	path           text           not null,
	bot            integer        not null,
	user_agent     text           not null,
	created_at     timestamp      not null                 check(strftime('%s', created_at) is not null)
);
create index "bots#site#created_at" on bots(site, created_at desc);

create table paths (
	path_id        {{auto_increment}},
	site           varchar        not null,

	path           varchar        not null,
	event          integer        default 0
);
create unique index "paths#site#path"  on paths(site, lower(path));

create table campaigns (
	campaign_id    {{auto_increment}},
	name           varchar        not null
);

create table browsers (
	browser_id     {{auto_increment}},

	name           varchar,
	version        varchar
);
create unique index "browsers#name#version" on browsers(name, version);

create table systems (
	system_id      {{auto_increment}},

	name           varchar,
	version        varchar
);
create unique index "systems#name#version"  on systems(name, version);

create table refs (
	ref_id         {{auto_increment}},
	ref            varchar        not null,
	ref_scheme     varchar        not null
);
insert into refs (ref, ref_scheme) values ('', 'o');
create unique index "refs#ref#ref_scheme" on refs(lower(ref), ref_scheme);

create table hit_counts (
	site           varchar        not null,
	path_id        integer        not null,

	hour           timestamp      not null                 check(strftime('%s', hour) is not null),
	total          integer        not null,

	constraint "hit_counts#site#path_id#hour" unique(site, path_id, hour) on conflict replace
);
create index "hit_counts#site#hour" on hit_counts(site, datetime(hour));

create table ref_counts (
	site           varchar        not null,
	path_id        integer        not null,

	ref_id         integer        not null,
	hour           timestamp      not null                 check(strftime('%s', hour) is not null),
	total          integer        not null,

	constraint "ref_counts#site#path_id#ref_id#hour" unique(site, path_id, ref_id, hour) on conflict replace
);
create index "ref_counts#site#hour" on ref_counts(site, datetime(hour));

-- IS rejects NULL from invalid dates; '+0 days' normalizes calendar overflows.
create table browser_stats (
	site           varchar        not null,
	path_id        integer        not null,
	browser_id     integer        not null,

	day            date           not null                 check(day is date(day, '+0 days')),
	count          integer        not null,

	constraint "browser_stats#site#path_id#day#browser_id" unique(site, path_id, day, browser_id) on conflict replace
);
create index "browser_stats#site#day"   on browser_stats(site, day);
create index "browser_stats#browser_id" on browser_stats(browser_id);

create table system_stats (
	site           varchar        not null,
	path_id        integer        not null,
	system_id      integer        not null,

	day            date           not null                 check(day is date(day, '+0 days')),
	count          integer        not null,

	constraint "system_stats#site#path_id#day#system_id" unique(site, path_id, day, system_id) on conflict replace
);
create index "system_stats#site#day"  on system_stats(site, day);
create index "system_stats#system_id" on system_stats(system_id);

create table location_stats (
	site           varchar        not null,
	path_id        integer        not null,

	day            date           not null                 check(day is date(day, '+0 days')),
	location       varchar        not null,
	count          integer        not null,

	constraint "location_stats#site#path_id#day#location" unique(site, path_id, day, location) on conflict replace
);
create index "location_stats#site#day" on location_stats(site, day);
create index "location_stats#location" on location_stats(location);

create table language_stats (
	site           varchar        not null,
	path_id        integer        not null,

	day            date           not null                 check(day is date(day, '+0 days')),
	language       varchar        not null,
	count          integer        not null,

	constraint "language_stats#site#path_id#day#language" unique(site, path_id, day, language) on conflict replace
);
create index "language_stats#site#day" on language_stats(site, day);
create index "language_stats#language" on language_stats(language);

create table size_stats (
	site           varchar        not null,
	path_id        integer        not null,

	day            date           not null                 check(day is date(day, '+0 days')),
	width          integer        not null,
	count          integer        not null,

	constraint "size_stats#site#path_id#day#width" unique(site, path_id, day, width) on conflict replace
);
create index "size_stats#site#day" on size_stats(site, day);
create index "size_stats#width" on size_stats(width);

create table campaign_stats (
	site           varchar        not null,
	path_id        integer        not null,

	day            date           not null                 check(day is date(day, '+0 days')),
	campaign_id    integer        not null,
	ref            varchar        not null,
	count          integer        not null,

	constraint "campaign_stats#site#path_id#campaign_id#ref#day" unique(site, path_id, campaign_id, ref, day) on conflict replace
);
create index "campaign_stats#site#day"    on campaign_stats(site, day);
create index "campaign_stats#campaign_id" on campaign_stats(campaign_id);

create table locations (
	location_id    {{auto_increment}},

	iso_3166_2     varchar        generated always as (country || (case region when '' then '' else ('-' || region) end)) stored,
	country        varchar        not null,
	region         varchar        not null,
	country_name   varchar        not null,
	region_name    varchar        not null
);
create unique index "locations#iso_3166_2" on locations(iso_3166_2);
insert into locations (country, country_name, region, region_name) values ('', '(unknown)', '', ''); -- id=1 is special.

create table languages (
	iso_639_3      varchar        not null,
	name           varchar        not null
);
create unique index "languages#iso_639_3" on languages(iso_639_3);
insert into languages (iso_639_3, name) values ('', '(unknown)'); -- Not sent, or a language we don't know.
{{include "languages.sql"}}

create table filters (
	filter_id     int        not null,
	site          varchar    not null,
	matches       int        not null,
	invert        bool       not null default false,
	query         text       not null,
	created_at    timestamp  not null   check(strftime('%s', created_at) is not null),
	last_used_at  timestamp  not null   check(strftime('%s', last_used_at) is not null)
);
create unique index "filters#filter_id" on filters(filter_id);
create unique index "filters#site#query" on filters(site, lower(query));

create table filter_paths (
	filter_id  int   not null,
	path_id    int   not null
);
create index "filter_paths#filter_id" on filter_paths(filter_id);

create table hit_queue (
    id integer primary key autoincrement,
    site varchar not null,
    payload blob not null
);

create table collector_sessions (
    key varchar primary key,
    site varchar not null,
    session blob not null,
    seen_at integer not null
);
create index "collector_sessions#seen_at" on collector_sessions(seen_at);

create table collector_session_paths (
    session blob not null,
    path_id integer not null,
    primary key(session, path_id)
);

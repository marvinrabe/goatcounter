-- GoatCounter database schema (SQLite).
--
-- This is a single-site installation: there is exactly one row in "site", and
-- none of the data tables are scoped to a site.

create table site (
	link_domain    varchar        not null default ''      check(link_domain = '' or (length(link_domain) >= 4 and length(link_domain) <= 255)),
	settings       varchar        not null default '{}',
	received_data  integer        not null default 0,
	created_at     timestamp      not null                 {{check_timestamp "created_at"}},
	updated_at     timestamp                               {{check_timestamp "updated_at"}},
	first_hit_at   timestamp      not null                 {{check_timestamp "first_hit_at"}}
);

create table users (
	user_id    {{auto_increment}},

	email      varchar        not null,
	password   {{blob}}       default null,

	created_at timestamp      not null,
	updated_at timestamp
);
create unique index "users#email" on users(lower(email));

create table hits (
	hit_id         {{auto_increment true}},
	path_id        integer        not null,
	ref_id         integer        not null default 1,

	session        {{blob}}       default null,
	first_visit    integer        default 0,

	browser_id     integer        not null,
	system_id      integer        not null,
	campaign       integer        default null,
	width          int            null,
	location       varchar        not null default '',
	language       varchar        default null,

	created_at     timestamp      not null                 {{check_timestamp "created_at"}}
);
create index "hits#created_at" on hits(created_at desc);

create table bots (
	path           text           not null,
	bot            integer        not null,
	user_agent     text           not null,
	created_at     timestamp      not null                 {{check_timestamp "created_at"}}
);
create index "bots#created_at" on bots(created_at desc);

create table paths (
	path_id        {{auto_increment}},

	path           varchar        not null,
	title          varchar        not null default '',
	event          integer        default 0
);
create unique index "paths#path"  on paths(lower(path));
create        index "paths#title" on paths(lower(title));

create table campaigns (
	campaign_id    {{auto_increment}},
	name           varchar        not null
);

create table browsers (
	browser_id     {{auto_increment}},

	name           varchar,
	version        varchar
);
create unique index "browsers#name#version" on browsers(name, version);

create table systems (
	system_id      {{auto_increment}},

	name           varchar,
	version        varchar
);
create unique index "systems#name#version"  on systems(name, version);

create table refs (
	ref_id         {{auto_increment}},
	ref            varchar        not null,
	ref_scheme     varchar        not null
);
insert into refs (ref, ref_scheme) values ('', 'o');
create unique index "refs#ref#ref_scheme" on refs(lower(ref), ref_scheme);

create table hit_counts (
	path_id        integer        not null,

	hour           timestamp      not null                 {{check_timestamp "hour"}},
	total          integer        not null,

	constraint "hit_counts#path_id#hour" unique(path_id, hour) on conflict replace
);
create index "hit_counts#hour" on hit_counts(hour);

create table ref_counts (
	path_id        integer        not null,

	ref_id         integer        not null,
	hour           timestamp      not null                 {{check_timestamp "hour"}},
	total          integer        not null,

	constraint "ref_counts#path_id#ref_id#hour" unique(path_id, ref_id, hour) on conflict replace
);
create index "ref_counts#hour" on ref_counts(hour);

create table browser_stats (
	path_id        integer        not null,
	browser_id     integer        not null,

	day            date           not null                 {{check_date "day"}},
	count          integer        not null,

	constraint "browser_stats#path_id#day#browser_id" unique(path_id, day, browser_id) on conflict replace
);
create index "browser_stats#day"        on browser_stats(day);
create index "browser_stats#browser_id" on browser_stats(browser_id);

create table system_stats (
	path_id        integer        not null,
	system_id      integer        not null,

	day            date           not null                 {{check_date "day"}},
	count          integer        not null,

	constraint "system_stats#path_id#day#system_id" unique(path_id, day, system_id) on conflict replace
);
create index "system_stats#day"       on system_stats(day);
create index "system_stats#system_id" on system_stats(system_id);

create table location_stats (
	path_id        integer        not null,

	day            date           not null                 {{check_date "day"}},
	location       varchar        not null,
	count          integer        not null,

	constraint "location_stats#path_id#day#location" unique(path_id, day, location) on conflict replace
);
create index "location_stats#day"      on location_stats(day);
create index "location_stats#location" on location_stats(location);

create table language_stats (
	path_id        integer        not null,

	day            date           not null                 {{check_date "day"}},
	language       varchar        not null,
	count          integer        not null,

	constraint "language_stats#path_id#day#language" unique(path_id, day, language) on conflict replace
);
create index "language_stats#day"      on language_stats(day);
create index "language_stats#language" on language_stats(language);

create table size_stats (
	path_id        integer        not null,

	day            date           not null                 {{check_date "day"}},
	width          integer        not null,
	count          integer        not null,

	constraint "size_stats#path_id#day#width" unique(path_id, day, width) on conflict replace
);
create index "size_stats#day"   on size_stats(day);
create index "size_stats#width" on size_stats(width);

create table campaign_stats (
	path_id        integer        not null,

	day            date           not null,
	campaign_id    integer        not null,
	ref            varchar        not null,
	count          integer        not null,

	constraint "campaign_stats#path_id#campaign_id#ref#day" unique(path_id, campaign_id, ref, day) on conflict replace
);
create index "campaign_stats#day"         on campaign_stats(day);
create index "campaign_stats#campaign_id" on campaign_stats(campaign_id);

create table locations (
	location_id    {{auto_increment}},

	iso_3166_2     varchar        generated always as (country || (case region when '' then '' else ('-' || region) end)) stored,
	country        varchar        not null,
	region         varchar        not null,
	country_name   varchar        not null,
	region_name    varchar        not null
);
create unique index "locations#iso_3166_2" on locations(iso_3166_2);
insert into locations (country, country_name, region, region_name) values ('', '(unknown)', '', ''); -- id=1 is special.

create table languages (
	iso_639_3      varchar        not null,
	name           varchar        not null
);
create unique index "languages#iso_639_3" on languages(iso_639_3);
insert into languages (iso_639_3, name) values ('', '(unknown)'); -- Not sent, or a language we don't know.
{{include "languages.sql"}}

create table store (
	key            varchar        not null,
	value          text
);
create unique index "store#key" on store(key);

create table filters (
	filter_id     int        not null,
	matches       int        not null,
	invert        bool       not null default false,
	query         text       not null,
	created_at    timestamp  not null   {{check_timestamp "created_at"}},
	last_used_at  timestamp  not null   {{check_timestamp "last_used_at"}}
);
create unique index "filters#filter_id" on filters(filter_id);

create table filter_paths (
	filter_id  int   not null,
	path_id    int   not null
);
create index "filter_paths#filter_id" on filter_paths(filter_id);

create table if not exists version (name varchar);
delete from version;
insert into version values
	('2026-09-11-1-single-site'),
	('2026-09-11-2-no-user-settings'),
	('2026-09-12-1-languages');

-- vim:ft=sql:tw=0

-- Language statistics; these were removed along with the i18n support, but the
-- two aren't related: this is the visitor's language, not the interface's.
alter table hits add column language varchar default null;

create table language_stats (
	path_id        integer        not null,

	day            date           not null                 {{check_date "day"}},
	language       varchar        not null,
	count          integer        not null,

	constraint "language_stats#path_id#day#language" unique(path_id, day, language) on conflict replace
);
create index "language_stats#day"      on language_stats(day);
create index "language_stats#language" on language_stats(language);

create table languages (
	iso_639_3      varchar        not null,
	name           varchar        not null
);
create unique index "languages#iso_639_3" on languages(iso_639_3);
insert into languages (iso_639_3, name) values ('', '(unknown)'); -- Not sent, or a language we don't know.
{{include "languages.sql"}}

-- Removing CollectLanguage shifted the flags after it (CollectSession and
-- CollectHits) down a bit; giving it its own bit back shifts them up again, so
-- move the stored settings along with them.
update site set settings = json_set(settings, '$.collect',
	(json_extract(settings, '$.collect') & 63) |
	((json_extract(settings, '$.collect') & ~63) * 2))
where json_extract(settings, '$.collect') is not null;

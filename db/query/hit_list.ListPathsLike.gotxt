with x as (
	select path_id, path from paths
	where site = :site and (
		{{if .match_case}}
			path like :search escape '\'
		{{else}}
			lower(path) like lower(:search) escape '\'
		{{end}}
	)
)
select
	path_id, path,
	sum(total) as count
from hit_counts
join x using(path_id)
group by path_id, path
order by count desc, path_id

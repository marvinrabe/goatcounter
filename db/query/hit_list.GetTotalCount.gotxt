with x as (
	select coalesce(sum(total), 0) as total
	from hit_counts
	where hour >= :start and hour <= :end and :filter
), y as (
	select coalesce(sum(total), 0) as total_utc
	from hit_counts
	where hour >= :start_utc and hour <= :end_utc and :filter
)
{{if .total_events}}, z as (
	select coalesce(sum(total), 0) as total_events
	from hit_counts
	join paths using (path_id)
	where hour >= :start and hour <= :end and paths.event = 1 and :filter
)
{{end}}
select
	*
from x, y{{if .total_events}}, z{{end}};

{{- if not .Rows -}}
 {{if not .RowsOnly}}<em class="text-sm not-italic text-slate-400 dark:text-neutral-500">Nothing to display</em>{{end}}
{{- else -}}
 {{if not .RowsOnly}}<div class="rows{{if .Pages}} pages{{end}}">{{end}}
 {{range .Rows}}
  <div class="hchart-row{{with .Class}} {{.}}{{end}} group flex min-w-0 items-center gap-3 py-1 text-sm" {{if .Page}}id="{{.Key}}" data-id="{{.Key}}" {{end}}data-key="{{.Key}}" data-detail-total="{{.Count}}">
   <span class="col-name relative min-w-0 flex-1 truncate text-slate-700 dark:text-neutral-200">
    {{if .Link}}<a href="#" class="hchart-row-link load-detail{{if .Page}} rlink{{end}} block truncate hover:text-fuchsia-700 dark:hover:text-fuchsia-300 hover:underline"{{if .Page}} title="{{.Key}}"{{end}}>{{template "_chart_bar" .}}</a>{{else}}{{template "_chart_bar" .}}{{end}}
   </span>
   <span class="col-count w-14 shrink-0 text-right font-semibold tabular-nums text-slate-800 dark:text-neutral-100">{{nformat .Count}}</span>
   <span class="col-count col-perc hidden w-12 shrink-0 text-right tabular-nums text-slate-400 dark:text-neutral-500 sm:inline">{{.Percentage}}</span>
  </div>
  {{if .Detail}}{{template "_chart_detail" .}}{{end}}
 {{end}}
 {{if not .RowsOnly}}</div>{{if .More}}{{template "_load_btns" true}}{{end}}{{end}}
{{- end -}}

{{/* The detail of a row, below it. */}}
{{define "_chart_detail" -}}
 <div class="hchart detail ml-3 border-l-2 border-slate-200 dark:border-neutral-700 pl-4" data-widget="{{.Detail.Widget}}" data-key="{{.Key}}" data-total="{{.Count}}">{{template "_chart.gohtml" .Detail}}</div>
{{- end}}

{{define "_chart_bar" -}}
 <span aria-hidden="true" class="bar absolute inset-y-0 left-0 rounded bg-fuchsia-100 dark:bg-fuchsia-400/15 group-hover:bg-fuchsia-200/70 dark:group-hover:bg-fuchsia-400/25" style="width: {{.Percentage}}"></span>
 <span class="bar-c relative block truncate px-2 py-0.5"><span class="cutoff">{{.Name}}</span>{{if .VisitURL}} <sup class="go ml-1 text-[10px]"><a rel="noopener" target="_blank" href="{{.VisitURL}}" class="text-slate-500 dark:text-neutral-400 underline">visit</a></sup>{{end}}</span>
{{- end}}

{{/* "Show more" and "Show less" links, for the chart or pages list they're in. */}}
{{define "_load_btns" -}}
 <div class="load-btns mt-4 flex items-center gap-3 text-xs">
  <a href="#" class="load-more font-semibold text-fuchsia-700 hover:underline dark:text-fuchsia-300">Show more <span aria-hidden="true">↓</span></a>
  <a href="#" class="load-less hidden border-l border-slate-300 pl-3 text-slate-500 hover:underline dark:border-neutral-600 dark:text-neutral-400">Show less <span aria-hidden="true">↑</span></a>
 </div>
{{- end}}

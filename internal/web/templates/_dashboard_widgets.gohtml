<div id="dash-widgets">
	{{template "_dashboard_totals.gohtml" .Totals}}
	<div class="hcharts dashboard-grid mt-5 grid grid-cols-1 gap-5 md:grid-cols-2">
		{{range .Cards}}
		<section class="dashboard-card min-w-0 overflow-hidden rounded-2xl border border-slate-200 dark:border-neutral-800 bg-white dark:bg-neutral-900" data-card-tabs data-card="{{.Name}}">
			<div class="card-tabs flex min-h-14 items-end gap-5 overflow-x-auto border-b border-slate-200 dark:border-neutral-800 px-5" role="tablist" aria-label="{{.Label}}">
				{{range $i, $t := .Tabs}}
				<button type="button" class="card-tab cursor-pointer whitespace-nowrap border-b-2 border-transparent pb-3 pt-4 text-sm font-semibold text-slate-500 dark:text-neutral-400 hover:text-slate-900 dark:hover:text-neutral-100 aria-selected:border-fuchsia-600 dark:aria-selected:border-fuchsia-500 aria-selected:text-slate-900 dark:aria-selected:text-neutral-100" data-panel="{{.Name}}" aria-selected="{{eq $i 0}}">{{.Label}}</button>
				{{end}}
				<span class="ml-auto pb-3 text-xs text-slate-500 dark:text-neutral-400">Visitors</span>
			</div>
			{{range $i, $t := .Tabs}}
			<div class="card-panel min-h-56 p-5" data-panel="{{.Name}}"{{if $i}} hidden{{end}}>{{template "_dashboard_chart.gohtml" index $.Panels .Name}}</div>
			{{end}}
		</section>
		{{end}}
	</div>
</div>

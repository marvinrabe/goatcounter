<section class="widget totals dashboard-card overflow-hidden rounded-2xl border border-slate-200 dark:border-neutral-800 bg-white dark:bg-neutral-900" data-widget="totals">
	<div class="metric-strip grid grid-cols-2 border-b border-slate-200 dark:border-neutral-800 md:grid-cols-6" aria-label="Traffic summary">
		{{template "_metric" (metric "visitors" "Unique visitors" (nformat .Metrics.Visitors) (change .Metrics.Visitors .Prev.Visitors false))}}
		{{template "_metric" (metric "visits" "Total visits" (nformat .Metrics.Visits) (change .Metrics.Visits .Prev.Visits false))}}
		{{template "_metric" (metric "pageviews" "Pageviews" (nformat .Metrics.Pageviews) (change .Metrics.Pageviews .Prev.Pageviews false))}}
		{{template "_metric" (metric "views_per_visit" "Views per visit" (printf "%.2f" .Metrics.ViewsPerVisit) (change .Metrics.ViewsPerVisit .Prev.ViewsPerVisit false))}}
		{{template "_metric" (metric "bounce_rate" "Bounce rate" (printf "%.0f%%" .Metrics.BounceRate) (change .Metrics.BounceRate .Prev.BounceRate true))}}
		{{template "_metric" (metric "visit_duration" "Visit duration" (printf "%v" .Metrics.VisitDuration) (change .Metrics.VisitDurationSeconds .Prev.VisitDurationSeconds false))}}
	</div>
	<div class="px-4 pb-5 pt-4 sm:px-6">
		{{if .Err}}
			<em class="text-sm text-red-600 dark:text-red-400">Error: {{.Err.Error}}</em>
		{{else}}
			<div class="chart metric-chart relative h-64 w-full" data-series="{{.Series | json}}" data-metric="visits">
				<canvas class="block h-full w-full"></canvas>
			</div>
		{{end}}
	</div>
</section>

{{define "_metric" -}}
<button type="button" class="metric min-w-0 cursor-pointer border-b border-r border-slate-200 dark:border-neutral-800 px-4 py-5 text-left hover:bg-fuchsia-50 dark:hover:bg-neutral-800 focus-visible:outline-2 focus-visible:outline-fuchsia-500 aria-pressed:bg-fuchsia-50 aria-pressed:shadow-[inset_0_-3px_0_var(--color-fuchsia-500)] dark:aria-pressed:bg-fuchsia-950/30 md:border-b-0 md:last:border-r-0" data-metric="{{.Key}}" aria-pressed="{{eq .Key "visits"}}">
	<span class="block truncate text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-neutral-400">{{.Label}}</span>
	<strong class="mt-2 block text-2xl font-semibold tracking-tight text-slate-800 dark:text-neutral-100">{{.Value}}</strong>
	{{with .Change -}}
	<span class="metric-change mt-1 block text-xs font-medium tabular-nums {{if not .Show}}text-slate-400 dark:text-neutral-500{{else if .Good}}text-emerald-600 dark:text-emerald-400{{else}}text-rose-600 dark:text-rose-400{{end}}" title="Compared to the previous period">
		{{- if .Show}}{{if .Up}}↑{{else}}↓{{end}} {{.Text}}{{else}}&nbsp;{{end -}}
	</span>
	{{- end}}
</button>
{{- end}}

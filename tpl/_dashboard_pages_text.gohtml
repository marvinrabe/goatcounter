<div class="pages-list pages-list-text {{if .Group.Daily}}pages-list-daily{{end}} widget-{{if $.Loaded}}loaded{{else}}loading{{end}} text-sm" data-widget="{{.ID}}">
	<div class="widget-header hidden"><h2>Pages <small><span class="total-display">{{nformat .TotalDisplay}}</span> page visits shown across <span class="total">{{nformat .Total}}</span> visits</small></h2></div>
	<div class="hchart count-list-pages" data-widget="{{.ID}}" data-max="{{.Max}}">
		{{template "_chart.gohtml" (horizontal_chart_pages .Pages .Total .ShowRefs .Refs .ID false)}}
	</div>
	<div class="load-btns mt-4 flex items-center gap-3 text-xs">
		<a href="#" class="load-more font-semibold text-fuchsia-700 hover:underline dark:text-fuchsia-300 {{if not .MorePages}}hidden{{end}}">Show more <span aria-hidden="true">↓</span></a>
		{{if .MorePages}}<a href="#" class="load-less hidden border-l border-slate-300 pl-3 text-slate-500 hover:underline dark:border-neutral-600 dark:text-neutral-400">Show less <span aria-hidden="true">↑</span></a>{{end}}
	</div>
</div>

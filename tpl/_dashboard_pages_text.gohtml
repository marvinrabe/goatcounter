<div class="pages-list pages-list-text {{if .Group.Daily}}pages-list-daily{{end}} widget-{{if $.Loaded}}loaded{{else}}loading{{end}}" data-widget="{{.ID}}">
	<div class="widget-header">
		<h2><span>{{t .Context "dashboard/pages/header|Pages"}}</span>
			<small>{{t .Context `dashboard/pages/num-visits|%(num-visits) out of %(total-visits) visits shown`
				(map
					"num-visits"   (tag "span" `class="total-display"` (nformat .TotalDisplay))
					"total-visits" (tag "span" `class="total"`         (nformat .Total))
				)}}</small>
		</h2>
	</div>

	<div class="hchart count-list-pages" data-widget="{{.ID}}" data-max="{{.Max}}">
		{{horizontal_chart_pages .Context .Pages .Total .ShowRefs .Refs .ID false}}
	</div>
	<div class="load-btns">
		<a href="#" class="load-more" {{if not .MorePages}}style="display: none"{{end}}>{{t .Context "link/show-more|Show more"}}</a>
		{{if .MorePages}}<a href="#" class="load-less">{{t .Context "link/show-less|(show less)"}}</a>{{end}}
	</div>
</div>

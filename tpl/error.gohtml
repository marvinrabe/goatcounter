<!DOCTYPE html>
<html lang="en" class="bg-slate-50 text-slate-800 dark:bg-neutral-950 dark:text-neutral-100 dark:[color-scheme:dark]">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Analytics – Error</title>
	{{if .StyleURL}}<link rel="stylesheet" href="{{.StyleURL}}">{{end}}
</head>
<body class="min-h-screen bg-slate-50 px-4 py-10 text-slate-800 antialiased dark:bg-neutral-950 dark:text-neutral-100">
	<main class="mx-auto max-w-xl rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 dark:border-neutral-800 dark:bg-neutral-900">
		{{if ne .Path "/"}}<a href="/" class="mb-8 inline-block text-sm font-medium text-fuchsia-700 hover:underline dark:text-fuchsia-300">← Home</a>{{end}}
		{{if eq .Code 404}}
			<h1 class="mb-2 text-2xl font-semibold tracking-tight">Not found</h1>
			<p class="text-slate-600 dark:text-neutral-300">This page doesn’t exist.</p>
		{{else if and (ge .Code 500) (ne .Code 504)}}
			<h1 class="mb-2 text-2xl font-semibold tracking-tight">Unexpected error</h1>
			<p class="text-slate-600 dark:text-neutral-300">An unexpected error occurred.</p>
		{{else}}
			<h1 class="mb-2 text-2xl font-semibold tracking-tight">Error {{.Code}}</h1>
			<p class="text-slate-600 dark:text-neutral-300">{{.Error}}</p>
		{{end}}
	</main>
</body>
</html>
